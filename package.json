{
  "name": "clickup-dock",
  "displayName": "ClickUp Dock",
  "publisher": "excelsior01",
  "description": "Manage ClickUp tasks and dispatch reports directly from your sidebar",
  "version": "0.0.4",
  "author": "excelsior01",
  "repository": {
    "type": "git",
    "url": "https://github.com/hermes13002/Clickup-dock.git"
  },
  "keywords": [
    "clickup",
    "tasks",
    "productivity",
    "management",
    "reports"
  ],
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:clickupDock.tasksView",
    "onView:clickupDock.reportDraftView"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "clickupDock-sidebar",
          "title": "ClickUp Dock",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "clickupDock.tasksView",
        "contents": "Welcome to ClickUp Dock!\n\nTo get started, please set your ClickUp API token.\n\nHow to get your token:\n1. Go to ClickUp Settings\n2. Click on Apps\n3. Copy your Personal API Token\n\n[Set ClickUp Token](command:clickupDock.setToken)",
        "when": "!clickupDock.hasToken"
      }
    ],
    "views": {
      "clickupDock-sidebar": [
        {
          "id": "clickupDock.tasksView",
          "name": "Tasks"
        },
        {
          "id": "clickupDock.reportDraftView",
          "name": "Draft Report",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "clickupDock.setToken",
        "title": "ClickUp Dock: Set ClickUp Token"
      },
      {
        "command": "clickupDock.configureReportList",
        "title": "ClickUp Dock: Configure Report Target"
      },
      {
        "command": "clickupDock.changeTaskStatus",
        "title": "Change Status",
        "icon": "$(edit)"
      },
      {
        "command": "clickupDock.refreshTasks",
        "title": "Refresh Tasks",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "clickupDock.refreshTasks",
          "when": "view == clickupDock.tasksView",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "clickupDock.changeTaskStatus",
          "when": "view == clickupDock.tasksView && viewItem == clickupTask",
          "group": "inline"
        }
      ]
    },
    "configuration": {
      "title": "ClickUp Dock",
      "properties": {
        "clickupDock.refreshInterval": {
          "type": "number",
          "default": 2,
          "description": "Auto-refresh interval in minutes (minimum 1)",
          "minimum": 1
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint"
  },
  "devDependencies": {
    "@types/node": "18.x",
    "@types/vscode": "^1.80.0",
    "sharp": "^0.35.4",
    "typescript": "^5.1.3"
  },
  "dependencies": {
    "axios": "^1.6.8"
  }
}
