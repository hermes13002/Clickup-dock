{
  "name": "clickup-dock",
  "displayName": "ClickUp Dock",
  "publisher": "clickup-dock-dev",
  "description": "Task management and weekly reporting via ClickUp",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "clickupDock-sidebar",
          "title": "ClickUp Dock",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "clickupDock-sidebar": [
        {
          "id": "clickupDock.tasksView",
          "name": "Tasks"
        },
        {
          "id": "clickupDock.reportDraftView",
          "name": "Draft Report",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "clickupDock.setToken",
        "title": "ClickUp Dock: Set ClickUp Token"
      },
      {
        "command": "clickupDock.configureReportList",
        "title": "ClickUp Dock: Configure Report Target"
      },
      {
        "command": "clickupDock.changeTaskStatus",
        "title": "Change Status",
        "icon": "$(edit)"
      },
      {
        "command": "clickupDock.refreshTasks",
        "title": "Refresh Tasks",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "clickupDock.refreshTasks",
          "when": "view == clickupDock.tasksView",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "clickupDock.changeTaskStatus",
          "when": "view == clickupDock.tasksView && viewItem == clickupTask",
          "group": "inline"
        }
      ]
    },
    "configuration": {
      "title": "ClickUp Dock",
      "properties": {
        "clickupDock.refreshInterval": {
          "type": "number",
          "default": 2,
          "description": "Auto-refresh interval in minutes (minimum 1)",
          "minimum": 1
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint"
  },
  "devDependencies": {
    "@types/vscode": "^1.80.0",
    "@types/node": "18.x",
    "typescript": "^5.1.3"
  },
  "dependencies": {
    "axios": "^1.6.8"
  }
}
